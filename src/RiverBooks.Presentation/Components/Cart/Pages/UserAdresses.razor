@page "/addresses"
@rendermode InteractiveServer
@using RiverBooks.Users.Contracts

@inject IApiCaller ApiCaller
@inject NavigationManager NavigationManager

@attribute [StreamRendering]
@attribute [Authorize]

<PageTitle>Addresses</PageTitle>

<h1>Your addresses</h1>

@if (_addresses == null)
{
    <p>
        <em>Loading address list...</em>
    </p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Country</th>
                <th scope="col">City</th>
                <th scope="col">State</th>
                <th scope="col">Street 1</th>
                <th scope="col">Street 2</th>
                <th scope="col">Postal code</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (idx, item) in _addresses.Select((b, i) => (i, b)))
            {
                <tr>
                    <td>@(idx + 1)</td>
                    <td>@item.Country</td>
                    <td>@item.City</td>
                    <td>@item.State</td>
                    <td>@item.Street1</td>
                    <td>@item.Street2</td>
                    <td>@item.PostalCode</td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private List<UserAddressDto>? _addresses;

    protected override async Task OnInitializedAsync()
    {
        await ReloadCartItems();
    }

    private async Task ReloadCartItems()
    {
        _addresses = null;
        StateHasChanged();
        var response = await ApiCaller.ListUserAddresses();
        _addresses = response.Match(x => x, _ => []);
    }

}