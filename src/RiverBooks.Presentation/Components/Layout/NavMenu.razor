@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">River Books</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link p-3" href="" Match="NavLinkMatch.All">
                <Icon Name="IconName.HouseDoorFill" Class="me-3" /> Home
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="books">
                        <Icon Name="IconName.Book" Class="me-3" /> Books
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="cart">
                        <Icon Name="IconName.Cart" Class="me-3" /> Cart
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="addresses">
                        <Icon Name="IconName.PinMap" Class="me-3" /> Addresses
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="orderslist">
                        <Icon Name="IconName.CardChecklist" Class="me-3" /> Orders
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl"/>
                        <button type="submit" class="nav-link p-3">
                            <Icon Name="IconName.DoorOpen" Class="me-3" /> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="Account/Register">
                        <Icon Name="IconName.PersonAdd" Class="me-3" /> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link p-3" href="Account/Login">
                        <Icon Name="IconName.Person" Class="me-3" /> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}