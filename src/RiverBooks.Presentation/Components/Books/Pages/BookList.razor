@page "/books"
@using System.Globalization
@using RiverBooks.Books.Contracts

@inject IApiCaller ApiCaller
@inject NavigationManager NavigationManager

@attribute [StreamRendering]
@attribute [Authorize]

<PageTitle>Books</PageTitle>

<h1>Books</h1>

<div class="row">
    <div class="col-7">
        <NavLink href="@NavigationManager.GetUriWithReturn("/books/new")" class="btn btn-primary">New Book</NavLink>
    </div>
</div>

@if (_books is not null)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Title</th>
                <th scope="col">Author</th>
                <th scope="col">Price</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (idx, book) in _books.Select((b, i) => (i, b)))
            {
                <tr>
                    <td>@(idx + 1)</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Price.ToString("C", enCulture)</td>
                    <td>
                        <Button Color="ButtonColor.Primary"
                                Size="ButtonSize.Small"
                                @onclick="_ => EditPrice(book)"
                                TooltipTitle="Update price">
                            <Icon Name="IconName.CashCoin"></Icon> Update price
                        </Button>
                    </td>
                    <td>
                        <Button Color="ButtonColor.Warning"
                                Size="ButtonSize.Small"
                                @onclick="_ => ConfirmDelete(book)"
                                TooltipTitle="Delete book">
                            <Icon Name="IconName.Trash"></Icon> Delete book
                        </Button>
                    </td>
                    <td>

                        <Button Color="ButtonColor.Success"
                                Size="ButtonSize.Small"
                                @onclick="_ => ConfirmAddToCart(book)"
                                TooltipTitle="Add to cart">
                            <Icon Name="IconName.Cart"></Icon> Add to cart
                        </Button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<Modal @ref="_deleteBookModal" Title="Deleting book ?" CloseOnEscape="true">
    <BodyTemplate>
        <p>Are you sure you want to delete book: '@_book?.Title' ?</p>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_deleteBookModal.HideAsync">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=DeleteBook>Delete</button>
    </FooterTemplate>
</Modal>

<Modal @ref="_updatePriceModal" Title="Update book price" CloseOnEscape="true" ShowCloseButton="true">
    <BodyTemplate>
        <p>Provide new price for book: '@_book?.Title' ?</p>
        <CurrencyInput TValue="decimal" MaximumFractionDigits="2" id="price" Locale="en-US" class="form-control" @bind-Value="@_updatedPrice" Placeholder="Price" />
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_updatePriceModal.HideAsync">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=UpdatePrice>Update</button>
    </FooterTemplate>
</Modal>

<Modal @ref="_addToCartModal" Title="Add book to cart">
    <BodyTemplate>
        <p>Add book: '@_book?.Title' to cart?</p>
        <NumberInput id="quantity" @bind-Value="@_bookQuantity" class="form-control" aria-required="true" placeholder="Quantity" />
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_addToCartModal.HideAsync">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=AddToCart>Add</button>
    </FooterTemplate>
</Modal>

@code {

    [Inject] protected ToastService ToastService { get; set; } = default!;
    [Inject] protected PreloadService PreloadService { get; set; } = default!;

    private CultureInfo enCulture { get; set; } = CultureInfo.GetCultureInfo("en-US");
    private Modal _deleteBookModal = null!;
    private Modal _updatePriceModal = null!;
    private Modal _addToCartModal = null!;
    private List<BookDto>? _books;
    private BookDto? _book;
    private decimal _updatedPrice;
    private int _bookQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await ReloadBookList();
    }

    private async Task ReloadBookList()
    {
        try
        {
            PreloadService.Show(SpinnerColor.Secondary, "Loading books...");
            StateHasChanged();
            var booksResponse = await ApiCaller.GetAllBooks();
            _books = booksResponse.Match(x => x.Books, _ => []);
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, "Unexpected error", ex.Message));
        }
        finally
        {
            PreloadService.Hide();
            StateHasChanged();
        }
    }

    private Task ConfirmDelete(BookDto book)
    {
        _book = book;
        return _deleteBookModal.ShowAsync();
    }

    private async Task DeleteBook()
    {
        if (_book is not null)
        {
            await ApiCaller.DeleteBook(_book.Id);
            await ReloadBookList();
        }

        await _deleteBookModal.HideAsync();
        _book = null;
    }

    private Task EditPrice(BookDto book)
    {
        _book = book;
        _updatedPrice = _book.Price;
        return _updatePriceModal.ShowAsync();
    }

    private async Task UpdatePrice()
    {
        if (_book is not null)
        {
            var result = await ApiCaller.UpdateBookPrice(_book.Id, _updatedPrice);
            if (!result.IsSuccess)
            {
                ToastService.Notify(new(ToastType.Danger, result.Error.Code, result.Error.Description));
                return;
            }
            await ReloadBookList();
        }

        _updatedPrice = 0;
        await _updatePriceModal.HideAsync();

        _book = null;
    }

    private Task ConfirmAddToCart(BookDto book)
    {
        _book = book;
        _bookQuantity = 1;
        return _addToCartModal.ShowAsync();
    }

    private async Task AddToCart()
    {
        if (_book is not null)
        {
            var result = await ApiCaller.AddBookToCart(_book.Id, _bookQuantity);
            if (!result.IsSuccess)
            {
                ToastService.Notify(new(ToastType.Danger, result.Error.Code, result.Error.Description));
                return;
            }
            await ReloadBookList();
        }

        await _addToCartModal.HideAsync();
        _book = null;
    }

}