@page "/books"
@rendermode InteractiveServer
@using RiverBooks.Books.Contracts

@inject IApiCaller ApiCaller
@inject NavigationManager NavigationManager

@* @attribute [StreamRendering] *@
@attribute [Authorize]

<PageTitle>Books</PageTitle>

<h1>Books</h1>

<div class="row">
    <div class="col-7">
        <NavLink href="@(NavigationManager.GetUriWithQueryParameters("/books/new", new Dictionary<string, object?> { ["ReturnUrl"] = "/books" }))" class="btn btn-sm btn-primary">Add Book</NavLink>
    </div>
</div>

@if (_books == null)
{
    <p>
        <em>Loading books...</em>
    </p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Title</th>
                <th scope="col">Author</th>
                <th scope="col">Price</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (idx, book) in _books.Select((b, i) => (i, b)))
            {
                <tr>
                    <td scope="row">@(idx + 1)</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Price</td>
                    <td>
                        <a class="nav-link" href="#">Update price</a>
                    </td>
                    <td>
                        <button type="button" class="btn" @onclick="_ => ConfirmDelete(book)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_showModal)
{
    <div class="modal fade show" id="myModal" style="display:block" aria-modal="true" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Deleting book</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@HideModal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    <p>Are you sure you want to delete book: '@_bookToDelete?.Title' ?</p>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@HideModal">Cancel</button>
                    <button type="button" class="btn btn-success" @onclick=@DeleteBook>Delete</button>
                </div>

            </div>
        </div>
    </div>
}

@code {

    private List<BookDto>? _books;
    private BookDto? _bookToDelete;
    bool _showModal;

    protected override async Task OnInitializedAsync()
    {
        await ReloadBookList();
    }

    private async Task ReloadBookList()
    {
        _books = null;
        StateHasChanged();
        var booksResponse = await ApiCaller.GetAllBooks();
        _books = booksResponse.Match(x => x.Books, _ => []);
    }

    private void HideModal() => _showModal = false;

    protected void ConfirmDelete(BookDto book)
    {
        _bookToDelete = book;
        _showModal = true;
    }

    private async Task DeleteBook()
    {
        if (_bookToDelete is not null)
        {
            await ApiCaller.DeleteBook(_bookToDelete.Id);
            await ReloadBookList();
        }

        HideModal();
        _bookToDelete = null;
    }
}