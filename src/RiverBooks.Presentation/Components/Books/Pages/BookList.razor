@page "/books"
@using RiverBooks.Books.Contracts

@inject IApiCaller ApiCaller
@inject NavigationManager NavigationManager

@attribute [StreamRendering]
@attribute [Authorize]

<PageTitle>Books</PageTitle>

<h1>Books</h1>

<div class="row">
    <div class="col-7">
        <NavLink href="@(NavigationManager.GetUriWithQueryParameters("/books/new", new Dictionary<string, object?> { ["ReturnUrl"] = "/books" }))" class="btn btn-sm btn-primary">Add Book</NavLink>
    </div>
</div>

@if (_books is not null)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Title</th>
                <th scope="col">Author</th>
                <th scope="col">Price</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (idx, book) in _books.Select((b, i) => (i, b)))
            {
                <tr>
                    <td>@(idx + 1)</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Price.ToString("C")</td>
                    <td>
                        <button type="button" class="btn btn-link" @onclick="_ => EditPrice(book)">Update price</button>
                    </td>
                    <td>
                        <button type="button" class="btn btn-link" @onclick="_ => ConfirmDelete(book)">Delete book</button>
                    </td>
                    <td>
                        <button type="button" class="btn btn-link" @onclick="_ => ConfirmAddToCart(book)">Add to cart</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<EditableModal @ref="_deleteBookModal" Title="Deleting book ?">
    <BodyContent>
        <p>Are you sure you want to delete book: '@_book?.Title' ?</p>
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_deleteBookModal.Hide">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=DeleteBook>Delete</button>
    </FooterContent>
</EditableModal>

<EditableModal @ref="_updatePriceModal" Title="Update book price">
    <BodyContent>
        <p>Provide new price for book: '@_book?.Title' ?</p>
        <InputNumber id="price" @bind-Value="@_updatedPrice" class="form-control" autocomplete="price" aria-required="true" placeholder="Price" />
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_updatePriceModal.Hide">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=UpdatePrice>Update</button>
    </FooterContent>
</EditableModal>

<EditableModal @ref="_addToCartModal" Title="Add book to cart">
    <BodyContent>
        <p>Add book: '@_book?.Title' to cart?</p>
        <InputNumber id="quantity" @bind-Value="@_bookQuantity" class="form-control" autocomplete="quantity" aria-required="true" placeholder="Quantity" />
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn" data-bs-dismiss="modal" @onclick="@_updatePriceModal.Hide">Cancel</button>
        <button type="button" class="btn btn-success" @onclick=AddToCart>Add</button>
    </FooterContent>
</EditableModal>

@code {

    [Inject] protected ToastService ToastService { get; set; } = default!;
    [Inject] protected PreloadService PreloadService { get; set; } = default!;

    private EditableModal _deleteBookModal = null!;
    private EditableModal _updatePriceModal = null!;
    private EditableModal _addToCartModal = null!;
    private List<BookDto>? _books;
    private BookDto? _book;
    private decimal _updatedPrice;
    private int _bookQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await ReloadBookList();
        ToastService.Notify(new(ToastType.Primary, "Hello in RiverBooks on initialized"));
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        ToastService.Notify(new(ToastType.Secondary, IconName.Exclamation, "River books", $"{DateTime.Now}", "After render called"));
    }

    private async Task ReloadBookList()
    {
        try
        {
            PreloadService.Show(SpinnerColor.Secondary, "Loading books...");
            StateHasChanged();
            var booksResponse = await ApiCaller.GetAllBooks();
            _books = booksResponse.Match(x => x.Books, _ => []);
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, "Unexpected error", ex.Message));
        }
        finally
        {
            PreloadService.Hide();
            StateHasChanged();
        }
    }

    private void ConfirmDelete(BookDto book)
    {
        _book = book;
        _deleteBookModal.Show();
    }

    private async Task DeleteBook()
    {
        if (_book is not null)
        {
            await ApiCaller.DeleteBook(_book.Id);
            await ReloadBookList();
        }

        _deleteBookModal.Hide();
        _book = null;
    }

    private void EditPrice(BookDto book)
    {
        _book = book;
        _updatedPrice = _book.Price;
        _updatePriceModal.Show();
    }

    private async Task UpdatePrice()
    {
        if (_book is not null)
        {
            var result = await ApiCaller.UpdateBookPrice(_book.Id, _updatedPrice);
            if (!result.IsSuccess)
            {
                _updatePriceModal.ErrorMessage = result.Error?.Description;
                return;
            }
            await ReloadBookList();
        }

        _updatedPrice = 0;
        _updatePriceModal.Hide();
        _book = null;
    }

    private void ConfirmAddToCart(BookDto book)
    {
        _book = book;
        _bookQuantity = 1;
        _addToCartModal.Show();
    }

    private async Task AddToCart()
    {
        if (_book is not null)
        {
            var result = await ApiCaller.AddBookToCart(_book.Id, _bookQuantity);
            if (!result.IsSuccess)
            {
                _addToCartModal.ErrorMessage = result.Error?.Description;
                return;
            }
            await ReloadBookList();
        }

        _addToCartModal.Hide();
        _book = null;
    }

}